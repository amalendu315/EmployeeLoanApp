    private async Task SendAgreementEmail()
    {
        // 1. Call Service to Email & Update Status
        await LoanService.SendAgreementToEmployeeAsync(_selectedApp.ApplicationID);

        Snackbar.Add("Agreement Sent to Employee!", Severity.Success);
        _agreementDrawerOpen = false;
        await LoadData(); // Refresh UI to show 'Awaiting Sign'
    }

    // --- UPLOAD SIGNED DOC ---
    private async Task UploadSignedAgreement(IBrowserFile file, int appId)
    {
        var folder = Path.Combine(Env.WebRootPath, "uploads", "agreements");
        Directory.CreateDirectory(folder);
        var path = Path.Combine(folder, $"Signed_{appId}_{file.Name}");

        using var fs = new FileStream(path, FileMode.Create);
        await file.OpenReadStream(5000000).CopyToAsync(fs);

        await LoanService.UploadSignedAgreementAsync(appId, path);
        Snackbar.Add("Document Uploaded. Ready for Disbursement.", Severity.Success);
        await LoadData();
    }

    // --- PAYMENT LOGIC ---
    private void OpenPaymentDialog(LoanApplication app)
    {
        _selectedApp = app;
        _paymentProofName = null;
        _paymentRemarks = "";
        _showPaymentDialog = true;
    }

    private async Task UploadPaymentProof(IBrowserFile file)
    {
        _paymentProofName = file.Name;
        var path = Path.Combine(Env.WebRootPath, "uploads", "payments", $"Pay_{Guid.NewGuid()}_{file.Name}");
        // In real app, save file stream here
        _paymentProofPath = path;
    }

    private async Task SubmitDisbursement()
    {
        await LoanService.DisburseLoanAsync(_selectedApp.ApplicationID);
        _showPaymentDialog = false;
        Snackbar.Add("Loan Activated!", Severity.Success);
        await LoadData();
    }

    // --- SANCTION DIALOG ---
    private async Task OpenSanctionDialog(LoanApplication app)
    {
        var parameters = new DialogParameters<ApprovalDialog> {
            { x => x.ApplicationId, app.ApplicationID },
            { x => x.RequestedAmount, app.LoanAmountRequested },
            { x => x.ApplicantName, app.Employee?.FullName ?? "Unknown" }
        };
        var dialog = await DialogService.ShowAsync<ApprovalDialog>("Sanction", parameters);
        var result = await dialog.Result;
        if (!result.Canceled) await LoadData();
    }

    // --- EDIT LOGIC ---
    private void OpenEditSheet(LoanApplication app)
    {
        _selectedLoan = app;
        _drawerOpen = true;
    }

    private async Task SaveLoanChanges()
    {
        await LoanService.UpdateLoanAsync(_selectedLoan, "HR_Admin");
        Snackbar.Add("Updated!", Severity.Success);
        _drawerOpen = false;
        await LoadData();
    }
