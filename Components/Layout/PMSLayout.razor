@inherits LayoutComponentBase
@using EmployeeLoanApp.Components.Pages.PMS
@using Microsoft.AspNetCore.Components.Authorization
@using EmployeeLoanApp.Services.PMS
@using EmployeeLoanApp.Services
@inject PMSAuthService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="_pmsTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<AuthorizeView>
    <Authorized>
        <!-- SYSTEM GUARD: Only show layout if logged into PMS -->
        @if (context.User.HasClaim(c => c.Type == "SystemName" && c.Value == "PMS"))
        {
            <MudLayout>
                <MudAppBar Elevation="1" Color="Color.Surface" Fixed="true" Class="border-b-2">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="ml-3" Style="font-weight:600;">Property Management</MudText>
                    <MudSpacer />
                    <div class="d-flex align-center gap-4">
                        <MudText Color="Color.Secondary" Typo="Typo.body2"><b>@context.User.Identity?.Name</b></MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Error" OnClick="HandleLogout" />
                    </div>
                </MudAppBar>

                <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
                    <MudNavMenu>
                        <MudNavLink Href="/pms" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>

                        <MudNavGroup Title="Manage Properties" Icon="@Icons.Material.Filled.Domain" Expanded="true">
                            <MudNavLink Href="/pms/properties/owned" Icon="@Icons.Material.Filled.Home">Owned Properties</MudNavLink>
                            <MudNavLink Href="/pms/properties/leased" Icon="@Icons.Material.Filled.Business">Leased Properties</MudNavLink>
                        </MudNavGroup>

                        <MudNavLink Href="/pms/reports" Icon="@Icons.Material.Filled.Assessment">Reports</MudNavLink>

                        @if (context.User.IsInRole("SuperAdmin"))
                        {
                            <MudNavLink Href="/pms/admin/users" Icon="@Icons.Material.Filled.SupervisedUserCircle">User Management</MudNavLink>
                        }
                    </MudNavMenu>
                </MudDrawer>

                <MudMainContent Class="mud-background-gray">
                    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
                        @Body
                    </MudContainer>
                </MudMainContent>
            </MudLayout>
        }
        else
        {
            <!-- Authenticated in LMS, but Anonymous in PMS -> Show Login -->
            <div class="d-flex justify-center align-center" style="min-height: 100vh; background-color: #F8FAFC;">
                <PmsLogin />
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="d-flex justify-center align-center" style="min-height: 100vh; background-color: #F8FAFC;">
            <PmsLogin />
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    bool _drawerOpen = true;
    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private async Task HandleLogout()
    {
        if (AuthStateProvider is UnifiedAuthenticationStateProvider unifiedProvider)
        {
            await unifiedProvider.LogoutSpecificAsync("pms"); // Only kill PMS Session
        }
        Nav.NavigateTo("/pms", forceLoad: true);
    }

    private MudTheme _pmsTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#6EC1E4",
            Secondary = "#54595F",
            TextPrimary = "#54595F",
            TextSecondary = "#7A7A7A",
            Success = "#61CE70",
            Info = "#4054B2",
            Background = "#F3F5F7",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography() { FontFamily = new[] { "Open Sans", "Helvetica", "Arial", "sans-serif" } }
        }
    };
}