@using EmployeeLoanApp.Components.Layout
@using EmployeeLoanApp.Components.Pages
@using EmployeeLoanApp.Components.Pages.LMS
@using EmployeeLoanApp.Components.Pages.PMS
@inject NavigationManager NavManager

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <!-- SMART LOGIN REDIRECTION -->
                    <!-- If the URL contains '/pms', show the PMS Login. Otherwise show Loan Login -->
                    @if (IsPmsRoute())
                    {
                        <div class="d-flex justify-center align-center" style="min-height: 100vh; background-color: #F8FAFC;">
                            <!-- Create this component next -->
                            <PmsLogin /> 
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-center align-center" style="min-height: 100vh; background-color: #F8FAFC;">
                            <Login />
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-center align-center" style="height:100vh">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="d-flex flex-column align-center justify-center mt-16">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Style="font-size: 64px;" />
                    <MudText Typo="Typo.h4" Class="mt-4">404 - Page Not Found</MudText>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Go Home</MudButton>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private bool IsPmsRoute()
    {
        var uri = NavManager.Uri;
        // Check if the URL segment contains '/pms'
        return uri.Contains("/pms", StringComparison.OrdinalIgnoreCase);
    }
}